@model List<Diary.Domain.Models.DiaryEntry>

<div class="container">
    <div class="row pt-4">
        <div class="col-6">
            <a class="btn btn-primary" asp-controller="DiaryEntries" asp-action="Create"><i class="bi bi-journal-plus"></i> Create new Diary Entry</a>
        </div>
    </div>
</div>

<br/>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
        <tr>
                <th>Title</th>
                <th>Content</th>
                <th>Date</th>
                <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                    <td>@entry.Title</td>
                    <td>@entry.Content</td>
                    <td>@entry.CreateDate</td>
                    <td><a asp-controller="DiaryEntries" asp-action="Edit" asp-route-id="@entry.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </td>
                    <td><a asp-controller="DiaryEntries" asp-action="Delete" asp-route-id="@entry.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-pencil"></i> Delete
                        </a>
                    </td>
            </tr>
        }
        </tbody>
    </table>
</div>